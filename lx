// 动态加工题库：确保所有章节都有 10 道题，并为大章添加总结小节
const COURSE_DATA = RAW_COURSE_DATA.map(chapter => {
  const processedSections = chapter.sections.map(section => {
    const paddedExercises = [...(section.exercises || [])];
    let i = paddedExercises.length;
    while (paddedExercises.length < 10) {
      paddedExercises.push(getPaddedExercise(section.title, section.id, i));
      i++;
    }
    return { ...section, exercises: paddedExercises };
  });

  // 【新增】为每个大章追加一个“总结与综合测验”小节
  processedSections.push({
    id: `${chapter.id}-summary`,
    title: '🎯 本章总结与综合测验',
    summary: `《${chapter.title}》章节核心点回顾：\n\n在本章中，您学习了该模块下相关的基础结构、高级特性和经典开发范式。从基础逻辑的编排到高级抽象思维的应用，熟练掌握本章内容是迈向资深 Python 开发者的必经之路。\n\n下方的 10 道综合测试题将把本大章涉及的知识点进行杂糅与融合考察。建议您在不翻阅之前代码的情况下，独立尝试完成这些挑战！`,
    exercises: Array.from({ length: 10 }).map((_, idx) => getChapterSummaryExercise(chapter.title, chapter.id, idx))
  });

  return {
    ...chapter,
    sections: processedSections
  };
});

export default function App() {
  const [pyodide, setPyodide] = useState(null);
  const [isLoadingPy, setIsLoadingPy] = useState(true);
  
  // 状态：UI导航
  const [activeChapterId, setActiveChapterId] = useState(COURSE_DATA[0].id);
  const [activeSectionId, setActiveSectionId] = useState(COURSE_DATA[0].sections[0].id);
  const [activeExerciseIndex, setActiveExerciseIndex] = useState(0); // 核心：题目游标 (0 - 9)
  const [expandedChapters, setExpandedChapters] = useState({ [COURSE_DATA[0].id]: true });

  // 状态：代码和执行
  const [userCodes, setUserCodes] = useState({}); 
  const [consoleOutput, setConsoleOutput] = useState('');
  const [isError, setIsError] = useState(false);
  const [isRunning, setIsRunning] = useState(false);
  const [successStatus, setSuccessStatus] = useState({}); 
  const [showAnswer, setShowAnswer] = useState(false); 

  const activeChapter = COURSE_DATA.find(c => c.id === activeChapterId);
  const activeSection = activeChapter?.sections.find(s => s.id === activeSectionId);
  const activeExercise = activeSection?.exercises[activeExerciseIndex];
  const isLastExercise = activeExerciseIndex === (activeSection?.exercises.length - 1);
  const isFirstExercise = activeExerciseIndex === 0;

  // 初始化加载 Pyodide (WebAssembly Python 解释器)
  useEffect(() => {
    const loadPyodideAsync = async () => {
      try {
        if (!window.loadPyodide) {
          const pyodideScript = document.createElement('script');
          pyodideScript.src = "https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js";
          pyodideScript.onload = async () => {
            let py = await window.loadPyodide();
            setPyodide(py);
            setIsLoadingPy(false);
          };
          document.body.appendChild(pyodideScript);
        } else {
          let py = await window.loadPyodide();
          setPyodide(py);
          setIsLoadingPy(false);
        }
      } catch (err) {
        console.error("加载 Pyodide 失败:", err);
        setConsoleOutput("⚠️ Python 运行环境加载失败，请检查网络连接。");
        setIsLoadingPy(false);
      }
    };
    loadPyodideAsync();
  }, []);

  // 切换题目时，如果未写代码，则填充初始代码
  useEffect(() => {
    if (activeExercise && !userCodes[activeExercise.id]) {
      setUserCodes(prev => ({
        ...prev,
        [activeExercise.id]: activeExercise.initialCode
      }));
    }
    setConsoleOutput('');
    setIsError(false);
    setShowAnswer(false);
  }, [activeSectionId, activeExerciseIndex, activeExercise, userCodes]);

  const toggleChapter = (chapterId) => {
    setExpandedChapters(prev => ({
      ...prev,
      [chapterId]: !prev[chapterId]
    }));
  };

  const handleSectionClick = (chapterId, sectionId) => {
    setActiveChapterId(chapterId);
    setActiveSectionId(sectionId);
    setActiveExerciseIndex(0); // 切换章节时重置到第 1 题
  };

  const handleCodeChange = (e) => {
    if (!activeExercise) return;
    setUserCodes(prev => ({
      ...prev,
      [activeExercise.id]: e.target.value
    }));
  };

  const runPythonCode = async () => {
    if (!pyodide || !activeExercise) return;
    
    setIsRunning(true);
    setConsoleOutput('运行中...');
    setIsError(false);
    
    const codeToRun = userCodes[activeExercise.id];
    
    try {
      await pyodide.runPythonAsync(`
import sys
import io
sys.stdout = io.StringIO()
sys.stderr = io.StringIO()
      `);
      
      await pyodide.runPythonAsync(codeToRun);
      
      const stdout = await pyodide.runPythonAsync("sys.stdout.getvalue()");
      const stderr = await pyodide.runPythonAsync("sys.stderr.getvalue()");
      
      const finalOutput = stdout + stderr;
      setConsoleOutput(finalOutput || '(无输出)');
      
      if (activeExercise.expectedOutput) {
        const normalizedOutput = finalOutput.trim().replace(/\r\n/g, '\n');
        const expected = activeExercise.expectedOutput.trim().replace(/\r\n/g, '\n');
        
        if (normalizedOutput === expected || normalizedOutput.includes(expected)) {
            setSuccessStatus(prev => ({ ...prev, [activeExercise.id]: true }));
        } else {
            setSuccessStatus(prev => ({ ...prev, [activeExercise.id]: false }));
        }
      }

    } catch (err) {
      setIsError(true);
      setConsoleOutput(err.toString());
      setSuccessStatus(prev => ({ ...prev, [activeExercise.id]: false }));
    } finally {
      setIsRunning(false);
    }
  };

  const handleKeyDown = (e) => {
    if (e.key === 'Tab' && activeExercise) {
      e.preventDefault();
      const textarea = e.target;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const newValue = textarea.value.substring(0, start) + '    ' + textarea.value.substring(end);
      setUserCodes(prev => ({ ...prev, [activeExercise.id]: newValue }));
      setTimeout(() => { textarea.selectionStart = textarea.selectionEnd = start + 4; }, 0);
    }
  };

  // 综合计算小节的通关状态（是否完成至少1题）
  const getSectionSuccess = (section) => {
    return section.exercises.some(ex => successStatus[ex.id]);
  };

  return (
    <div className="flex flex-col h-screen bg-gray-50 font-sans">
      
      {/* 顶部导航条 */}
      <header className="bg-slate-900 text-white p-4 shadow-md flex items-center justify-between z-10 relative">
        <div className="flex items-center space-x-3">
          <BookOpen className="w-6 h-6 text-blue-400" />
          <h1 className="text-xl font-bold tracking-wide">廖雪峰 Python 强化练习平台</h1>
        </div>
        <div className="flex items-center space-x-4 text-sm text-gray-300">
          {isLoadingPy ? (
            <span className="flex items-center"><span className="animate-pulse w-2 h-2 bg-yellow-400 rounded-full mr-2"></span> Python环境加载中...</span>
          ) : (
            <span className="flex items-center"><span className="w-2 h-2 bg-green-400 rounded-full mr-2"></span> Python环境已就绪</span>
          )}
        </div>
      </header>

      <div className="flex flex-1 overflow-hidden">
        
        {/* 左侧目录 */}
        <div className="w-64 bg-white border-r border-gray-200 flex flex-col overflow-y-auto z-0">
          <div className="p-4 bg-gray-50 border-b border-gray-200 text-sm font-semibold text-gray-600 uppercase tracking-wider flex justify-between items-center">
            <span>课程目录</span>
          </div>
          <div className="flex-1 py-2">
            {COURSE_DATA.map((chapter) => (
              <div key={chapter.id} className="mb-1">
                <button
                  onClick={() => toggleChapter(chapter.id)}
                  className="w-full flex items-center justify-between px-4 py-2 hover:bg-gray-100 transition-colors text-left"
                >
                  <span className="font-medium text-gray-800">{chapter.title}</span>
                  {expandedChapters[chapter.id] ? (
                    <ChevronDown className="w-4 h-4 text-gray-500" />
                  ) : (
                    <ChevronRight className="w-4 h-4 text-gray-500" />
                  )}
                </button>
                
                {expandedChapters[chapter.id] && (
                  <div className="bg-gray-50 py-1">
                    {chapter.sections.map(section => {
                      const isActive = activeSectionId === section.id;
                      const isSuccess = getSectionSuccess(section);
                      return (
                        <button
                          key={section.id}
                          onClick={() => handleSectionClick(chapter.id, section.id)}
                          className={`w-full flex items-center pl-8 pr-4 py-2 text-sm text-left transition-colors
                            ${isActive ? 'bg-blue-100 text-blue-700 font-medium' : 'text-gray-600 hover:bg-gray-200'}`}
                        >
                          <span className="truncate flex-1">{section.title}</span>
                          {isSuccess && <CheckCircle className="w-4 h-4 text-green-500 ml-2 flex-shrink-0" />}
                        </button>
                      );
                    })}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

        {/* 右侧工作区 */}
        <div className="flex-1 flex flex-col bg-gray-50 overflow-hidden relative">
          
          {/* 题目分页栏 (水平滚动) */}
          {activeSection && (
            <div className="bg-white border-b border-gray-200 px-4 py-2 flex items-center overflow-x-auto whitespace-nowrap scrollbar-hide shadow-sm z-10">
              <span className="text-sm font-bold text-gray-500 mr-4 flex-shrink-0">
                {activeSection.title} (共10题)
              </span>
              <div className="flex space-x-2">
                {activeSection.exercises.map((ex, idx) => {
                  const isCurrent = idx === activeExerciseIndex;
                  const passed = successStatus[ex.id];
                  return (
                    <button
                      key={ex.id}
                      onClick={() => setActiveExerciseIndex(idx)}
                      className={`flex items-center px-3 py-1.5 text-sm rounded-full transition-all flex-shrink-0
                        ${isCurrent 
                          ? 'bg-blue-600 text-white shadow-md' 
                          : passed 
                            ? 'bg-green-50 text-green-700 border border-green-200 hover:bg-green-100'
                            : 'bg-gray-100 text-gray-600 hover:bg-gray-200 border border-transparent'
                        }`}
                    >
                      <span>题 {idx + 1}</span>
                      {passed && <CheckCircle className={`w-3 h-3 ml-1 ${isCurrent ? 'text-white' : 'text-green-500'}`} />}
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          {activeExercise ? (
            <div className="flex-1 flex flex-col overflow-y-auto">
              
              {/* 大章总结区块 (仅当选中小节具有 summary 属性时展示) */}
              {activeSection.summary && (
                <div className="p-6 bg-gradient-to-r from-indigo-50 to-blue-50 border-b border-indigo-100 flex-shrink-0 animate-in fade-in slide-in-from-top-2">
                  <h3 className="text-lg font-extrabold text-indigo-900 mb-2 flex items-center">
                    <Target className="w-5 h-5 mr-2 text-indigo-600" /> 
                    大章阶段性回顾
                  </h3>
                  <div className="text-indigo-800 leading-relaxed whitespace-pre-wrap text-sm md:text-base">
                    {activeSection.summary}
                  </div>
                </div>
              )}

              {/* 题目说明 */}
              <div className="p-6 bg-white border-b border-gray-200 flex-shrink-0">
                <div className="flex justify-between items-start">
                  <div>
                    <h2 className="text-2xl font-bold text-gray-900 mb-2">
                      {activeExerciseIndex + 1}. {activeExercise.title}
                    </h2>
                    <div className="text-gray-700 leading-relaxed whitespace-pre-wrap bg-blue-50/50 p-4 rounded-lg border border-blue-100 max-w-4xl">
                      {activeExercise.description}
                    </div>
                  </div>
                  
                  {/* 上下题导航器 */}
                  <div className="flex space-x-2 flex-shrink-0 ml-4">
                    <button 
                      onClick={() => setActiveExerciseIndex(Math.max(0, activeExerciseIndex - 1))}
                      disabled={isFirstExercise}
                      className="p-2 rounded-full border border-gray-200 hover:bg-gray-100 disabled:opacity-30 transition-all text-gray-600"
                    >
                      <ArrowLeft className="w-5 h-5" />
                    </button>
                    <button 
                      onClick={() => setActiveExerciseIndex(Math.min(activeSection.exercises.length - 1, activeExerciseIndex + 1))}
                      disabled={isLastExercise}
                      className="p-2 rounded-full border border-gray-200 hover:bg-gray-100 disabled:opacity-30 transition-all text-gray-600"
                    >
                      <ArrowRight className="w-5 h-5" />
                    </button>
                  </div>
                </div>

                {/* 答案与解析区域 */}
                <div className="mt-4">
                  <button 
                    onClick={() => setShowAnswer(!showAnswer)}
                    className="flex items-center space-x-2 text-sm text-yellow-600 font-medium hover:text-yellow-700 transition-colors bg-yellow-50 px-3 py-1.5 rounded-md border border-yellow-200"
                  >
                    <Lightbulb className="w-4 h-4" />
                    <span>{showAnswer ? '隐藏答案与解析' : '查看答案与解析'}</span>
                  </button>
                  
                  {showAnswer && (
                    <div className="mt-3 p-4 bg-yellow-50/80 border border-yellow-200 rounded-lg animate-in fade-in slide-in-from-top-2 max-w-4xl">
                      <h4 className="font-bold text-yellow-800 text-sm mb-2 flex items-center">
                        <Eye className="w-4 h-4 mr-1"/> 参考代码
                      </h4>
                      <pre className="bg-white p-3 rounded border border-yellow-100 text-sm font-mono text-gray-800 overflow-x-auto whitespace-pre-wrap">
                        {activeExercise.answer}
                      </pre>
                      <h4 className="font-bold text-yellow-800 text-sm mt-4 mb-2 flex items-center">
                        <BookOpen className="w-4 h-4 mr-1"/> 原理解析
                      </h4>
                      <p className="text-sm text-yellow-900 leading-relaxed whitespace-pre-wrap">
                        {activeExercise.explanation}
                      </p>
                    </div>
                  )}
                </div>
              </div>

              {/* 代码编辑区和控制台 */}
              <div className="flex-1 flex flex-col lg:flex-row p-4 gap-4 overflow-hidden min-h-[400px]">
                
                {/* 编辑器 */}
                <div className="flex-1 flex flex-col bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                  <div className="bg-slate-800 text-gray-200 px-4 py-2 flex justify-between items-center text-sm font-mono border-b border-slate-700">
                    <div className="flex items-center space-x-2">
                      <Code className="w-4 h-4" />
                      <span>main.py</span>
                    </div>
                    <button
                      onClick={runPythonCode}
                      disabled={isLoadingPy || isRunning}
                      className={`flex items-center space-x-1 px-4 py-1.5 rounded text-white font-medium transition-colors shadow-sm
                        ${isLoadingPy || isRunning 
                          ? 'bg-slate-600 cursor-not-allowed' 
                          : 'bg-green-600 hover:bg-green-500'}`}
                    >
                      <Play className="w-4 h-4 fill-current" />
                      <span>{isRunning ? '运行中...' : '运行并测试'}</span>
                    </button>
                  </div>
                  <textarea
                    value={userCodes[activeExercise.id] || ''}
                    onChange={handleCodeChange}
                    onKeyDown={handleKeyDown}
                    className="flex-1 w-full p-4 bg-slate-900 text-slate-100 font-mono text-base leading-relaxed resize-none focus:outline-none"
                    spellCheck="false"
                    placeholder="在此编写您的 Python 代码..."
                  />
                </div>

                {/* 控制台 */}
                <div className="flex-1 flex flex-col bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                  <div className="bg-gray-100 text-gray-700 px-4 py-2 flex items-center justify-between text-sm font-medium border-b border-gray-200">
                    <div className="flex items-center space-x-2">
                      <Terminal className="w-4 h-4" />
                      <span>执行结果与反馈</span>
                    </div>
                  </div>
                  <div className={`flex-1 p-4 font-mono text-sm overflow-y-auto whitespace-pre-wrap
                    ${isError ? 'bg-red-50 text-red-700' : 'bg-slate-950 text-green-400'}`}
                  >
                    {consoleOutput || <span className="text-gray-500 italic">尚未执行，点击 "运行并测试" 查看输出...</span>}
                  </div>
                  
                  {/* 状态栏 */}
                  <div className="bg-gray-50 px-4 py-3 border-t border-gray-200 flex items-center justify-between text-sm">
                    {successStatus[activeExercise.id] === true && (
                      <div className="flex items-center justify-between w-full">
                        <span className="flex items-center text-green-600 font-medium">
                          <CheckCircle className="w-5 h-5 mr-1" />
                          恭喜过关！输出结果完全符合预期。
                        </span>
                        {!isLastExercise && (
                          <button 
                            onClick={() => setActiveExerciseIndex(activeExerciseIndex + 1)}
                            className="flex items-center space-x-1 text-blue-600 font-medium hover:text-blue-800"
                          >
                            <span>下一题</span>
                            <ArrowRight className="w-4 h-4" />
                          </button>
                        )}
                      </div>
                    )}
                    {successStatus[activeExercise.id] === false && consoleOutput && !isError && (
                      <span className="flex items-center text-yellow-600 font-medium">
                        <AlertCircle className="w-5 h-5 mr-1" />
                        输出结果不匹配（预期输出: {activeExercise.expectedOutput}），请检查代码。
                      </span>
                    )}
                    {isError && (
                      <span className="flex items-center text-red-600 font-medium">
                        <AlertCircle className="w-5 h-5 mr-1" />
                        代码执行发生错误，请查看控制台报错详情。
                      </span>
                    )}
                    {!consoleOutput && !isError && <span className="text-gray-400">编写代码并运行验证</span>}
                  </div>
                </div>

              </div>
            </div>
          ) : (
            <div className="flex-1 flex items-center justify-center text-gray-400">
              <p>题目加载异常</p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
