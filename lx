// --- 题库模板生成器 (用于动态扩充题目到至少10题) ---
function getPaddedExercise(sectionTitle, sectionId, index) {
  const templates = [
    {
      title: '基础打印测试',
      desc: `【巩固测试】作为熟悉 ${sectionTitle} 的第一步，请使用 \`print()\` 函数打印出本节标题："${sectionTitle}"。`,
      init: `# 请打印标题\n`,
      ans: `print("${sectionTitle}")`,
      out: sectionTitle
    },
    {
      title: '四则运算测试',
      desc: `【运算测试】请计算并打印 ${index * 10} + ${index * 5} 的结果。`,
      init: `# 计算并打印结果\n`,
      ans: `print(${index * 10 + index * 5})`,
      out: `${index * 10 + index * 5}`
    },
    {
      title: '布尔逻辑测试',
      desc: `【布尔测试】请打印表达式 \`10 > 5\` 的布尔值结果。`,
      init: `# 打印布尔判断结果\n`,
      ans: `print(10 > 5)`,
      out: `True`
    },
    {
      title: '循环结构强化',
      desc: `【循环测试】请使用 for 循环打印 3 次 "Python"（每次占一行）。`,
      init: `# 请使用循环打印\n`,
      ans: `for _ in range(3):\n    print("Python")`,
      out: `Python\nPython\nPython`
    },
    {
      title: '类型转换巩固',
      desc: `【类型转换】请将字符串 "2024" 转换为整数，并加上 1，打印最后的结果。`,
      init: `s = "2024"\n# 请在此处编写代码\n`,
      ans: `print(int(s) + 1)`,
      out: `2025`
    }
  ];
  const t = templates[index % templates.length];
  return {
    id: `ex-${sectionId}-padded-${index}`,
    title: t.title,
    description: t.desc,
    initialCode: t.init,
    expectedOutput: t.out,
    answer: t.ans,
    explanation: `这是针对【${sectionTitle}】的强化练习。大量的代码编写是掌握 Python 基础语法的关键环节。`
  };
}

// --- 大章综合测验模板生成器 (每个大章10道综合题) ---
function getChapterSummaryExercise(chapterTitle, chapterId, index) {
  const templates = [
    {
      title: '综合应用 - 逻辑判断',
      desc: `【综合测试1】结合本章知识，根据变量 x 的值进行判断：如果是偶数打印 "Even"，奇数打印 "Odd"。（假设 x = ${index + 4}）`,
      init: `x = ${index + 4}\n# 请编写综合逻辑\n`,
      ans: `x = ${index + 4}\nif x % 2 == 0:\n    print("Even")\nelse:\n    print("Odd")`,
      out: (index + 4) % 2 === 0 ? "Even" : "Odd"
    },
    {
      title: '综合应用 - 列表与循环',
      desc: `【综合测试2】遍历 range(1, 4)，将每个数字乘以本章的综合难度系数（假设为 ${index + 2}）并分行打印。`,
      init: `# 请编写代码\n`,
      ans: `for i in range(1, 4):\n    print(i * ${index + 2})`,
      out: [1, 2, 3].map(i => i * (index + 2)).join('\n')
    },
    {
      title: '综合应用 - 字符串处理',
      desc: `【综合测试3】将字符串 "python" 首字母大写，并与本大章标题拼接打印（中间加空格）。`,
      init: `title = "${chapterTitle}"\ns = "python"\n# 请编写代码\n`,
      ans: `title = "${chapterTitle}"\ns = "python"\nprint(s.capitalize() + " " + title)`,
      out: `Python ${chapterTitle}`
    },
    {
      title: '综合应用 - 异常与输出',
      desc: `【综合测试4】使用 print() 结合单行 if-else 表达式：如果当前大章标题包含 "面向对象" 四个字则输出 Yes，否则输出 No。`,
      init: `title = "${chapterTitle}"\n# 请编写代码\n`,
      ans: `title = "${chapterTitle}"\nprint("Yes" if "面向对象" in title else "No")`,
      out: chapterTitle.includes("面向对象") ? "Yes" : "No"
    },
    {
      title: '综合应用 - 数学综合计算',
      desc: `【综合测试5】计算表达式 (${index} * 10 + 5) 的平方，并打印最终结果。`,
      init: `# 请编写代码\n`,
      ans: `print((${index} * 10 + 5) ** 2)`,
      out: String((index * 10 + 5) ** 2)
    },
    {
      title: '综合应用 - 数据结构组合',
      desc: `【综合测试6】创建一个包含元素 [1, 2, 3] 的列表，向其末尾追加数字 ${index + 10}，最后打印列表的总长度。`,
      init: `L = [1, 2, 3]\n# 请编写代码\n`,
      ans: `L = [1, 2, 3]\nL.append(${index + 10})\nprint(len(L))`,
      out: '4'
    },
    {
      title: '综合应用 - 字典读取',
      desc: `【综合测试7】给定字典 d = {'chapter': '${chapterTitle}', 'score': 100}，请根据 key 打印出 score 的值。`,
      init: `d = {'chapter': '${chapterTitle}', 'score': 100}\n# 请编写代码\n`,
      ans: `d = {'chapter': '${chapterTitle}', 'score': 100}\nprint(d['score'])`,
      out: '100'
    },
    {
      title: '综合应用 - 集合去重',
      desc: `【综合测试8】给定列表 L = [1, 2, 2, 3, 3, 3]，使用 set() 函数进行去重，并打印去重后的元素总个数。`,
      init: `L = [1, 2, 2, 3, 3, 3]\n# 请编写代码\n`,
      ans: `L = [1, 2, 2, 3, 3, 3]\nprint(len(set(L)))`,
      out: '3'
    },
    {
      title: '综合应用 - 类型识别',
      desc: `【综合测试9】请打印出变量 ${index + 0.5} 的数据类型名称（即 float）。提示：使用 type(val).__name__ 获取名称字符串。`,
      init: `val = ${index + 0.5}\n# 请编写代码\n`,
      ans: `val = ${index + 0.5}\nprint(type(val).__name__)`,
      out: 'float'
    },
    {
      title: '综合应用 - 圆满结课',
      desc: `【综合测试10】恭喜你来到了本章最后一道题！请用 print() 输出："【${chapterTitle}】综合测试通过！"`,
      init: `# 请编写代码庆祝\n`,
      ans: `print("【${chapterTitle}】综合测试通过！")`,
      out: `【${chapterTitle}】综合测试通过！`
    }
  ];
  
  const t = templates[index % templates.length];
  return {
    id: `ex-${chapterId}-summary-${index}`,
    title: t.title,
    description: t.desc,
    initialCode: t.init,
    expectedOutput: t.out,
    answer: t.ans,
    explanation: `这是【${chapterTitle}】的跨小节综合测验。综合运用所学知识（如控制流、数据结构组合等）才能在实际开发中游刃有余。`
  };
}

